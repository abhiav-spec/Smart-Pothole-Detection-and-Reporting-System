generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  AUTHORITY
  ADMIN
}

enum PotholeStatus {
  REPORTED
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum PotholeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  reports       Report[]
  notifications Notification[]
  statusUpdates PotholeStatusHistory[] // user who changed the status

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Authority {
  id    String  @id @default(uuid())
  name  String
  code  String  @unique
  email String  @unique
  phone String?

  potholes Pothole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pothole {
  id          String          @id @default(uuid())
  latitude    Float
  longitude   Float
  severity    PotholeSeverity
  status      PotholeStatus   @default(REPORTED)
  confidence  Float?
  description String?

  authorityId String?
  authority   Authority? @relation(fields: [authorityId], references: [id])

  detections    Detection[]
  media         Media[]
  reports       Report[]
  statusHistory PotholeStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([authorityId])
  @@index([createdAt])
}

model Detection {
  id           String  @id @default(uuid())
  potholeId    String
  pothole      Pothole @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  confidence   Float
  className    String
  boundingBox  Json? // Store x, y, width, height or similar
  modelVersion String

  createdAt DateTime @default(now())
}

model Media {
  id        String    @id @default(uuid())
  potholeId String
  pothole   Pothole   @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType
  fileName  String
  mimeType  String
  size      Int // Size in bytes

  createdAt DateTime @default(now())
}

model Report {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  potholeId   String
  pothole     Pothole @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  description String?

  createdAt DateTime @default(now())
}

model PotholeStatusHistory {
  id          String        @id @default(uuid())
  potholeId   String
  pothole     Pothole       @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  oldStatus   PotholeStatus
  newStatus   PotholeStatus
  changedById String?
  changedBy   User?         @relation(fields: [changedById], references: [id])
  reason      String?

  createdAt DateTime @default(now())
}

model Notification {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String
  type    String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
}
